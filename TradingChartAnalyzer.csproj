<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>6f62423c-5c4f-4129-ac7a-d5461b059947</UserSecretsId>
    <TailwindCli>$(MSBuildProjectDirectory)\node_modules\.bin\tailwindcss.cmd</TailwindCli>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="9.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="node_modules\**" />
    <Content Remove="node_modules\**;package.json;package-lock.json" />
    <None Remove="node_modules\**" />
    <Content Update="App_Data\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildTailwind" BeforeTargets="BeforeBuild" Condition="Exists('$(TailwindCli)')">
    <Exec Command="&quot;$(TailwindCli)&quot; -i wwwroot/css/input.css -o wwwroot/css/site.css --minify" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
