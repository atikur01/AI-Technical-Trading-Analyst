{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Binance": {
    "RestBaseUrl": "https://api.binance.com",
    "WsBaseUrl": "wss://stream.binance.com:9443/ws",
    "DefaultSymbol": "BTCUSDT",
    "CacheSeconds": 10
  },
  "TwelveData": {
    "RestBaseUrl": "https://api.twelvedata.com",
    "CacheSeconds": 30,
    "PollSeconds": 60,
    "ForexPairs": [ "EUR/USD", "GBP/USD", "USD/JPY", "USD/CHF", "AUD/USD", "USD/CAD", "NZD/USD", "EUR/GBP", "EUR/JPY", "GBP/JPY" ],
    "Stocks": [ "AAPL", "MSFT", "GOOGL", "AMZN", "NVDA", "TSLA", "META", "NFLX", "AMD", "INTC", "JPM", "V", "DIS", "BA", "KO", "PEP", "WMT", "XOM", "SPY", "QQQ" ]
  },
  "Ai": {
    "BaseUrl": "https://api.meta.ai/v1/responses",
    "Model": "muse-spark-1.3",
    "Temperature": 0.2,
    "MaxTokens": 16000,
    "TimeoutSeconds": 180,
    "CacheMinutes": 5
  }
}
