<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AI Trading Chart Analyzer</title>
    <meta name="theme-color" content="#0b0e14" />
    <meta name="description" content="AI-powered trading chart analysis with trade setups drawn directly on a live chart." />
    <link rel="icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="h-full overflow-hidden bg-tv-bg text-tv-text antialiased">
    @RenderBody()
    <div id="toast-container" class="pointer-events-none fixed right-4 top-16 z-50 flex w-80 max-w-[calc(100vw-2rem)] flex-col gap-2"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/lightweight-charts/lightweight-charts.standalone.production.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
